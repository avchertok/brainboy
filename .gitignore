# --- Private WhatsApp data (never commit) ---
# Ignore contents of these folders but keep the folders themselves (.gitkeep).
data/raw/*
data/media/*
data/drafts/*
!data/raw/.gitkeep
!data/media/.gitkeep
!data/drafts/.gitkeep
*.zip
# WhatsApp export text can contain phone numbers / private messages
_chat.txt

